{
  "name": "griff-credits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --project demo-griff-credits",
    "test:rules": "firebase emulators:exec --only firestore --project demo-griff-credits \"vitest run\"",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "check:data": "tsx scripts/check.ts",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "firebase": "^12.3.0",
    "pdfmake": "^0.3.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.0.0",
    "nodemailer": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
